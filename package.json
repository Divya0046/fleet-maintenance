{
  "name": "fleet-maintenance",
  "version": "1.0.0",
  "private": true,
  "description": "Fleet maintenance management system",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "build:web": "npm --workspace apps/web run build",
    "build:api": "npm --workspace apps/api run build",
    "postinstall": "prisma skills sync || exit 0"
  },
  "devDependencies": {
    "prisma": "8.0.0-rc.12"
  },
  "dependencies": {
    "csv-parse": "^7.0.2"
  }
}
